{
  "name": "opic-speech-quest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run content:build && next dev -H 127.0.0.1",
    "build": "npm run content:build && next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run content:validate && npm run typecheck && npm run lint",
    "content:build": "tsx scripts/build-content.ts",
    "content:validate": "tsx scripts/build-content.ts --validate-only",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.0.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.0.0",
    "yaml": "^2.0.0"
  },
  "type": "module"
}
